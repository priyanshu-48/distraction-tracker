PORT=3000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=distraction_tracker
DB_PASSWORD=change-me
DB_PORT=5432
JWT_SECRET=change-me-to-a-long-random-string
# The login cookie is Secure in production. Set to false only for plain http on a local setup (Docker),
# true to force it elsewhere.
# COOKIE_SECURE=false
# Comma-separated list of allowed dashboard origins
CORS_ORIGINS=http://localhost:5173
# Max Postgres connections in the pool (default 10)
DB_POOL_MAX=10
# Optional: send budget alerts through a notification service (see decisions.md, D-39). Off unless BOTH are set,
# and each user must also switch it on in Settings. Nothing is sent about a user who has not.
# NOTIFICATIONS_API_URL=http://localhost:3001
# NOTIFICATIONS_API_KEY=ntf_live_...
